---
import StoreBadge from "./StoreBadge.astro";
import StatusBadge from "./StatusBadge.astro";

interface ServiceData {
  name: string;
  url: string;
  type: "web" | "app" | "both";
  description: string;
  screenshot: string;
  category: string;
  tags: string[];
  author: string;
  repo?: string;
  appStore?: string;
  playStore?: string;
  longDescription?: string;
  ogImage?: string;
  featured?: boolean;
  publishedAt: Date;
  enriched?: boolean;
}

interface Props {
  service: {
    data: ServiceData;
    id: string;
  };
}

const { service } = Astro.props;
const { data, id } = service;

const typeLabel: Record<string, string> = {
  web: "웹",
  app: "앱",
  both: "웹+앱",
};

const typeBadgeClass: Record<string, string> = {
  web: "bg-blue-100 text-blue-700",
  app: "bg-purple-100 text-purple-700",
  both: "bg-emerald-100 text-emerald-700",
};
---

<a
  href={`/services/${id}`}
  class="group flex flex-col rounded-xl border border-gray-200 bg-white overflow-hidden hover:shadow-lg hover:scale-[1.015] transition-all duration-200 cursor-pointer"
  data-type={data.type}
  data-category={data.category}
>
  <!-- Screenshot -->
  <div class="relative w-full overflow-hidden bg-gray-100" style="aspect-ratio: 16/10;">
    <img
      src={data.screenshot}
      alt={`${data.name} 스크린샷`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      decoding="async"
    />
    <!-- Type badge overlaid on image -->
    <span class={`absolute top-2 right-2 text-xs font-semibold px-2 py-0.5 rounded-full ${typeBadgeClass[data.type] ?? "bg-gray-100 text-gray-600"}`}>
      {typeLabel[data.type] ?? data.type}
    </span>
  </div>

  <!-- Card body -->
  <div class="flex flex-col gap-2 p-4 flex-1">
    <!-- Name + status -->
    <div class="flex items-center gap-2 min-w-0">
      <h3 class="text-sm font-bold text-gray-900 leading-snug line-clamp-1 min-w-0">
        {data.name}
      </h3>
      <StatusBadge slug={id} locale="ko" />
      <span class="vote-count text-xs text-neutral-400 ml-auto shrink-0" data-vote-slug={id}>▲</span>
    </div>

    <!-- Description -->
    <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">
      {data.description}
    </p>

    <!-- Tags -->
    {data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-auto pt-2">
        {data.tags.slice(0, 4).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-medium">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Store badges -->
    {(data.appStore || data.playStore) && (
      <div class="pt-1">
        <StoreBadge appStore={data.appStore} playStore={data.playStore} />
      </div>
    )}
  </div>
</a>

<script>
  (async () => {
    try {
      const res = await fetch('/votes.json');
      if (!res.ok) return;
      const data = await res.json();
      document.querySelectorAll<HTMLElement>('.vote-count[data-vote-slug]').forEach((el) => {
        const slug = el.dataset.voteSlug!;
        const entry = data.services?.[slug];
        if (entry?.count != null) {
          el.textContent = `▲ ${entry.count}`;
        }
      });
    } catch {}
  })();
</script>
