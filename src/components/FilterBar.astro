---
const categories = [
  { value: "all", label: "전체" },
  { value: "productivity", label: "생산성" },
  { value: "developer-tools", label: "개발 도구" },
  { value: "design", label: "디자인" },
  { value: "communication", label: "커뮤니케이션" },
  { value: "education", label: "교육" },
  { value: "finance", label: "금융" },
  { value: "health", label: "건강" },
  { value: "entertainment", label: "엔터테인먼트" },
  { value: "social", label: "소셜" },
  { value: "utilities", label: "유틸리티" },
  { value: "ai", label: "AI" },
  { value: "other", label: "기타" },
];
---

<div class="flex flex-wrap items-center gap-3 py-3">
  <!-- Type filter -->
  <div class="flex items-center gap-1 rounded-lg border border-gray-200 bg-white p-1" role="group" aria-label="서비스 유형 필터">
    {[
      { value: "all", label: "전체" },
      { value: "web", label: "웹" },
      { value: "app", label: "앱" },
      { value: "both", label: "웹+앱" },
    ].map(({ value, label }) => (
      <button
        type="button"
        data-filter-type={value}
        class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
          value === "all"
            ? "bg-gray-900 text-white"
            : "text-gray-500 hover:text-gray-800 hover:bg-gray-100"
        }`}
      >
        {label}
      </button>
    ))}
  </div>

  <!-- Category dropdown -->
  <div class="relative">
    <select
      id="filter-category"
      class="appearance-none pl-3 pr-8 py-2 rounded-lg border border-gray-200 bg-white text-sm text-gray-700 font-medium cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
      aria-label="카테고리 필터"
    >
      {categories.map(({ value, label }) => (
        <option value={value}>{label}</option>
      ))}
    </select>
    <svg
      class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </div>

  <!-- Spacer -->
  <div class="flex-1"></div>

  <!-- Sort toggle -->
  <div class="flex items-center gap-1 rounded-lg border border-gray-200 bg-white p-1" role="group" aria-label="정렬 방식">
    {[
      { value: "latest", label: "최신순" },
      { value: "name", label: "이름순" },
    ].map(({ value, label }) => (
      <button
        type="button"
        data-sort={value}
        class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${
          value === "latest"
            ? "bg-gray-900 text-white"
            : "text-gray-500 hover:text-gray-800 hover:bg-gray-100"
        }`}
      >
        {label}
      </button>
    ))}
  </div>
</div>

<script>
  const grid = document.getElementById("services-grid");
  if (!grid) throw new Error("services-grid not found");

  const allCards = (): HTMLElement[] =>
    Array.from(grid.querySelectorAll<HTMLElement>(":scope > div[data-type]"));

  // ── State ──────────────────────────────────────────────────────────────────
  let activeType = "all";
  let activeCategory = "all";
  let activeSort = "latest";

  // ── Helpers ────────────────────────────────────────────────────────────────
  function applyFilter() {
    const cards = allCards();

    // Show / hide
    for (const card of cards) {
      const matchType = activeType === "all" || card.dataset.type === activeType;
      const matchCat = activeCategory === "all" || card.dataset.category === activeCategory;
      card.style.display = matchType && matchCat ? "" : "none";
    }

    // Sort visible cards
    const visible = cards.filter((c) => c.style.display !== "none");
    visible.sort((a, b) => {
      if (activeSort === "name") {
        return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "", "ko");
      }
      // latest: descending publishedAt
      return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
    });
    for (const card of visible) grid.appendChild(card);
  }

  function setActiveTypeBtn(value: string) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-filter-type]")
      .forEach((btn) => {
        const isActive = btn.dataset.filterType === value;
        btn.classList.toggle("bg-gray-900", isActive);
        btn.classList.toggle("text-white", isActive);
        btn.classList.toggle("text-gray-500", !isActive);
        btn.classList.toggle("hover:text-gray-800", !isActive);
        btn.classList.toggle("hover:bg-gray-100", !isActive);
      });
  }

  function setActiveSortBtn(value: string) {
    document
      .querySelectorAll<HTMLButtonElement>("[data-sort]")
      .forEach((btn) => {
        const isActive = btn.dataset.sort === value;
        btn.classList.toggle("bg-gray-900", isActive);
        btn.classList.toggle("text-white", isActive);
        btn.classList.toggle("text-gray-500", !isActive);
        btn.classList.toggle("hover:text-gray-800", !isActive);
        btn.classList.toggle("hover:bg-gray-100", !isActive);
      });
  }

  // ── Event listeners ────────────────────────────────────────────────────────
  document
    .querySelectorAll<HTMLButtonElement>("[data-filter-type]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        activeType = btn.dataset.filterType ?? "all";
        setActiveTypeBtn(activeType);
        applyFilter();
      });
    });

  const categorySelect = document.getElementById("filter-category") as HTMLSelectElement | null;
  categorySelect?.addEventListener("change", () => {
    activeCategory = categorySelect.value;
    applyFilter();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeSort = btn.dataset.sort ?? "latest";
      setActiveSortBtn(activeSort);
      applyFilter();
    });
  });

  // Initial sort
  applyFilter();
</script>
