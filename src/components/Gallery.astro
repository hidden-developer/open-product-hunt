---
import ServiceCard from "./ServiceCard.astro";

interface ServiceData {
  name: string;
  url: string;
  type: "web" | "app" | "both";
  description: string;
  screenshot: string;
  category: string;
  tags: string[];
  author: string;
  repo?: string;
  appStore?: string;
  playStore?: string;
  longDescription?: string;
  ogImage?: string;
  featured?: boolean;
  publishedAt: Date;
  enriched?: boolean;
}

interface Props {
  services: Array<{
    data: ServiceData;
    id: string;
  }>;
}

const { services } = Astro.props;
---

{services.length === 0 ? (
  <div class="flex flex-col items-center justify-center py-20 text-gray-400">
    <svg class="w-12 h-12 mb-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="3" y="14" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/>
    </svg>
    <p class="text-sm font-medium">등록된 서비스가 없습니다.</p>
  </div>
) : (
  <div
    id="services-grid"
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"
  >
    {services.map((service) => (
      <div
        data-type={service.data.type}
        data-category={service.data.category}
        data-name={service.data.name.toLowerCase()}
        data-published={service.data.publishedAt.toISOString()}
      >
        <ServiceCard service={service} />
      </div>
    ))}
  </div>
)}
