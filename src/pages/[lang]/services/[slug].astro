---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Locale, locales, getDescription, getFaq, uiLabels, categoryLabels } from '../../../utils/i18n';
import Giscus from '../../../components/Giscus.astro';
import StatusBadge from '../../../components/StatusBadge.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const paths = [];
  for (const locale of locales) {
    for (const service of services) {
      paths.push({
        params: { lang: locale, slug: service.id },
        props: { service, locale },
      });
    }
  }
  return paths;
}

const { service, locale } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(service);

const allServices = await getCollection('services');
const related = allServices
  .filter((s) => s.id !== service.id && s.data.category === service.data.category)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 3);

const siteUrl = 'https://dal.ink';
const pageUrl = `${siteUrl}/${locale}/services/${service.id}/`;

const ui = uiLabels[locale];
const cats = categoryLabels[locale];

const typeLabel = service.data.type === 'web' ? 'Web' : service.data.type === 'app' ? 'App' : 'Web + App';

const localizedDescription = getDescription(service.data, locale);
const localizedFaq = getFaq(service.data, locale);

const otherLocale: Locale = locale === 'ko' ? 'en' : 'ko';
const otherLocaleLabel = locale === 'ko' ? 'English' : '한국어';

// JSON-LD: SoftwareApplication
const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': service.data.type === 'app' ? 'MobileApplication' : 'SoftwareApplication',
  name: service.data.name,
  description: localizedDescription,
  url: service.data.url,
  applicationCategory: service.data.category,
  image: service.data.ogImage ?? service.data.screenshot,
  inLanguage: locale === 'ko' ? 'ko-KR' : 'en-US',
  ...(service.data.appStore && {
    installUrl: service.data.appStore,
    operatingSystem: 'iOS',
  }),
  ...(service.data.playStore && {
    installUrl: service.data.playStore,
    operatingSystem: 'Android',
  }),
};

// JSON-LD: BreadcrumbList
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.home, item: `${siteUrl}/${locale}/` },
    { '@type': 'ListItem', position: 2, name: service.data.name, item: pageUrl },
  ],
};

// JSON-LD: FAQPage (if faq exists)
const faqJsonLd = localizedFaq && localizedFaq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: localizedFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<BaseLayout
  title={`${service.data.name} - Dalink`}
  description={localizedDescription}
  ogImage={service.data.ogImage ?? service.data.screenshot}
  canonicalUrl={pageUrl}
  lang={locale}
  alternateUrls={{ ko: `/ko/services/${service.id}/`, en: `/en/services/${service.id}/` }}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="ko" href={`${siteUrl}/ko/services/${service.id}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/services/${service.id}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/ko/services/${service.id}/`} />
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">

    <!-- Breadcrumb + Language switcher -->
    <div class="flex items-center justify-between mb-6">
      <nav class="flex items-center gap-2 text-sm text-neutral-400 dark:text-neutral-500" aria-label={ui.breadcrumbLabel}>
        <a href={`/${locale}/`} class="hover:text-neutral-700 dark:hover:text-neutral-300 transition-colors">{ui.home}</a>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-neutral-600 dark:text-neutral-400 truncate">{service.data.name}</span>
      </nav>
      <a
        href={`/${otherLocale}/services/${service.id}/`}
        class="shrink-0 ml-4 text-xs px-2.5 py-1 rounded-full border border-neutral-200 dark:border-neutral-700 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:border-neutral-400 dark:hover:border-neutral-500 transition-colors"
      >
        {otherLocaleLabel}
      </a>
    </div>

    <!-- Hero screenshot -->
    {service.data.screenshot && (
      <div class="rounded-xl overflow-hidden border border-neutral-200 dark:border-neutral-800 mb-8 bg-neutral-100 dark:bg-neutral-800">
        <img
          src={service.data.screenshot}
          alt={`${service.data.name} screenshot`}
          class="w-full object-cover max-h-[480px]"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <!-- Service info block -->
    <div class="flex flex-col sm:flex-row sm:items-start gap-6 mb-8">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white">
            {service.data.name}
          </h1>
          <StatusBadge slug={service.id} locale={locale} />
          <span class={`text-xs px-2.5 py-1 rounded-full font-medium ${
            service.data.type === 'web'
              ? 'bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400'
              : service.data.type === 'app'
              ? 'bg-green-50 dark:bg-green-950 text-green-600 dark:text-green-400'
              : 'bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400'
          }`}>
            {typeLabel}
          </span>
          {service.data.featured && (
            <span class="text-xs px-2.5 py-1 rounded-full font-medium bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400">
              {ui.featured}
            </span>
          )}
        </div>

        <p class="text-neutral-600 dark:text-neutral-400 text-base mb-4">
          {localizedDescription}
        </p>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 rounded-full">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            {cats[service.data.category as keyof typeof cats] ?? service.data.category}
          </span>
        </div>

        <div class="flex flex-wrap gap-1.5">
          {service.data.tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 rounded-md">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col gap-2 sm:min-w-[160px]">
        <a
          href={service.data.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          {ui.visitService}
        </a>

        {service.data.appStore && (
          <a
            href={service.data.appStore}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 px-4 py-2.5 bg-neutral-900 dark:bg-white hover:bg-neutral-700 dark:hover:bg-neutral-200 text-white dark:text-neutral-900 text-sm font-medium rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            App Store
          </a>
        )}

        {service.data.playStore && (
          <a
            href={service.data.playStore}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.18 23.76c.33.18.7.26 1.08.23l.06-.04L13.64 14 10.2 10.56 3.18 23.76zM20.43 9.6L17.3 7.87l-3.53 3.47 3.53 3.47 3.16-1.74a1.8 1.8 0 000-3.47zM2.44.69A1.8 1.8 0 002 1.87v20.26c0 .43.15.83.44 1.15l.06.05 11.34-11.33v-.27L2.44.69zM13.64 10l-3.44-3.44L4.32.32 4.26.28c-.38-.04-.75.05-1.08.23L10.2 7.56 13.64 10z"/>
            </svg>
            Play Store
          </a>
        )}

        {service.data.repo && (
          <a
            href={service.data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 px-4 py-2.5 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            {ui.sourceCode}
          </a>
        )}

        <!-- Share button -->
        <button
          id="share-btn"
          type="button"
          data-url={pageUrl}
          data-title={service.data.name}
          data-copied-label={ui.copied}
          class="flex items-center justify-center gap-2 px-4 py-2.5 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-label">{ui.share}</span>
        </button>
      </div>
    </div>

    <!-- Markdown body -->
    {service.body && (
      <div id="service-body" data-locale={locale} class="prose prose-neutral dark:prose-invert max-w-none mb-10 prose-headings:font-semibold prose-a:text-blue-600 dark:prose-a:text-blue-400">
        <Content />
      </div>
    )}
    <script is:inline>
      (function() {
        const container = document.getElementById('service-body');
        if (!container) return;
        const locale = container.dataset.locale;
        const html = container.innerHTML;
        const marker = '<!-- @en -->';
        const idx = html.indexOf(marker);
        if (idx === -1) return;
        if (locale === 'ko') {
          container.innerHTML = html.substring(0, idx);
        } else {
          container.innerHTML = html.substring(idx + marker.length);
        }
      })();
    </script>

    <!-- FAQ section -->
    {localizedFaq && localizedFaq.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold text-neutral-900 dark:text-white mb-4">{ui.faqTitle}</h2>
        <div class="divide-y divide-neutral-200 dark:divide-neutral-800 border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden">
          {localizedFaq.map((item) => (
            <details class="group bg-white dark:bg-neutral-900">
              <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
                <span class="font-medium text-neutral-900 dark:text-white text-sm">{item.question}</span>
                <svg class="w-4 h-4 text-neutral-400 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-4 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {item.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related services -->
    {related.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold text-neutral-900 dark:text-white mb-4">{ui.relatedServices}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((rel) => (
            <a
              href={`/${locale}/services/${rel.id}/`}
              class="group block rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden hover:shadow-md hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-200"
            >
              <div class="aspect-video bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
                {rel.data.screenshot ? (
                  <img
                    src={rel.data.screenshot}
                    alt={`${rel.data.name} screenshot`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-neutral-300 dark:text-neutral-600">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="p-3">
                <p class="font-medium text-sm text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                  {rel.data.name}
                </p>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 mt-0.5">
                  {getDescription(rel.data, locale)}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <Giscus locale={locale} term={service.id} />
  </div>
</BaseLayout>

<script>
  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;
  const shareBtnLabel = document.getElementById('share-btn-label');

  shareBtn?.addEventListener('click', async () => {
    const url = shareBtn.dataset.url ?? window.location.href;
    const title = shareBtn.dataset.title ?? document.title;
    const copiedLabel = shareBtn.dataset.copiedLabel ?? 'Copied!';

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        // User cancelled, ignore
      }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        if (shareBtnLabel) {
          shareBtnLabel.textContent = copiedLabel;
          setTimeout(() => {
            shareBtnLabel.textContent = shareBtn.dataset.shareLabel ?? title;
          }, 2000);
        }
      } catch {
        // Clipboard not available
      }
    }
  });
</script>
