---
// Root redirect page
---
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <title>Dalink - Service &amp; App Directory</title>
  <meta name="description" content="Open-source service &amp; app directory" />
  <link rel="canonical" href="https://dal.ink/ko/" />
  <link rel="alternate" hreflang="ko" href="https://dal.ink/ko/" />
  <link rel="alternate" hreflang="en" href="https://dal.ink/en/" />
  <link rel="alternate" hreflang="x-default" href="https://dal.ink/ko/" />
  <meta http-equiv="refresh" content="0;url=/ko/" />
  <script is:inline>
    const lang = navigator.language || navigator.userLanguage || 'ko';
    const target = lang.startsWith('en') ? '/en/' : '/ko/';
    window.location.replace(target);
  </script>
</head>
<body></body>
</html>
