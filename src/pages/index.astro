---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allServices = await getCollection('services');
const services = allServices.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const categories = [
  { value: 'all', label: '전체' },
  { value: 'productivity', label: '생산성' },
  { value: 'developer-tools', label: '개발자 도구' },
  { value: 'design', label: '디자인' },
  { value: 'communication', label: '커뮤니케이션' },
  { value: 'education', label: '교육' },
  { value: 'finance', label: '금융' },
  { value: 'health', label: '건강' },
  { value: 'entertainment', label: '엔터테인먼트' },
  { value: 'social', label: '소셜' },
  { value: 'utilities', label: '유틸리티' },
  { value: 'ai', label: 'AI' },
  { value: 'other', label: '기타' },
];

const siteUrl = 'https://dal.ink';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dalink',
  url: siteUrl,
  description: '누구나 PR로 등록하는 오픈소스 서비스 디렉토리',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dalink 서비스 목록',
  numberOfItems: services.length,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/services/${s.id}/`,
    name: s.data.name,
  })),
};
---

<BaseLayout
  title="Dalink - 서비스 & 앱 디렉토리"
  description="누구나 PR로 등록하는 오픈소스 서비스 & 앱 디렉토리. 유용한 웹 서비스와 앱을 발견하세요."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="border-b border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
      <div class="max-w-2xl">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-900 dark:text-white mb-3">
          누구나 PR로 등록하는<br />오픈소스 서비스 디렉토리
        </h1>
        <p class="text-neutral-500 dark:text-neutral-400 text-lg mb-6">
          유용한 웹 서비스와 앱을 발견하고, 직접 등록해보세요.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://github.com/hidden-developer/hidden-developer.github.io/blob/main/CONTRIBUTING.md"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            서비스 등록하기
          </a>
          <a
            href="https://github.com/hidden-developer/hidden-developer.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-700 transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Search & Filter -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-4">
    <!-- Search bar (Pagefind placeholder) -->
    <div class="mb-6">
      <div class="relative max-w-md">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="서비스 검색..."
          class="w-full pl-9 pr-4 py-2 text-sm bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 placeholder-neutral-400"
        />
      </div>
    </div>

    <!-- Category filter bar -->
    <div class="flex gap-2 flex-wrap" id="filter-bar" role="group" aria-label="카테고리 필터">
      {categories.map((cat) => (
        <button
          type="button"
          data-category={cat.value}
          class={`filter-btn px-3 py-1.5 rounded-full text-xs font-medium transition-colors border ${
            cat.value === 'all'
              ? 'bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 border-neutral-900 dark:border-white'
              : 'bg-white dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border-neutral-200 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </section>

  <!-- Gallery grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-6">
    <p class="text-sm text-neutral-400 dark:text-neutral-500 mb-4">
      <span id="count">{services.length}</span>개의 서비스
    </p>

    <div
      id="gallery"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
    >
      {services.map((service) => (
        <a
          href={`/services/${service.id}/`}
          class="service-card group block rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden hover:shadow-md hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-200"
          data-category={service.data.category}
          data-name={service.data.name.toLowerCase()}
          data-description={service.data.description.toLowerCase()}
          data-tags={service.data.tags.join(' ').toLowerCase()}
        >
          <!-- Screenshot -->
          <div class="aspect-video bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
            {service.data.screenshot ? (
              <img
                src={service.data.screenshot}
                alt={`${service.data.name} 스크린샷`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-neutral-300 dark:text-neutral-600">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            )}
          </div>

          <!-- Info -->
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="font-semibold text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-1">
                {service.data.name}
              </h2>
              <span class={`shrink-0 text-xs px-2 py-0.5 rounded-full font-medium ${
                service.data.type === 'web'
                  ? 'bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400'
                  : service.data.type === 'app'
                  ? 'bg-green-50 dark:bg-green-950 text-green-600 dark:text-green-400'
                  : 'bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400'
              }`}>
                {service.data.type === 'web' ? 'Web' : service.data.type === 'app' ? 'App' : 'Web+App'}
              </span>
            </div>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 mb-3">
              {service.data.description}
            </p>
            <div class="flex flex-wrap gap-1">
              {service.data.tags.slice(0, 3).map((tag) => (
                <span class="text-xs px-2 py-0.5 bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 rounded-md">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden py-20 text-center text-neutral-400 dark:text-neutral-500">
      <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <p class="text-sm">검색 결과가 없습니다.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.service-card');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const countEl = document.getElementById('count');
  const emptyState = document.getElementById('empty-state');

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cat = card.dataset.category ?? '';
      const name = card.dataset.name ?? '';
      const desc = card.dataset.description ?? '';
      const tags = card.dataset.tags ?? '';

      const matchesCategory = activeCategory === 'all' || cat === activeCategory;
      const matchesSearch =
        !searchQuery ||
        name.includes(searchQuery) ||
        desc.includes(searchQuery) ||
        tags.includes(searchQuery);

      const show = matchesCategory && matchesSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (countEl) countEl.textContent = String(visible);
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.category ?? 'all';

      filterBtns.forEach((b) => {
        const isActive = b.dataset.category === activeCategory;
        b.classList.toggle('bg-neutral-900', isActive);
        b.classList.toggle('dark:bg-white', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('dark:text-neutral-900', isActive);
        b.classList.toggle('border-neutral-900', isActive);
        b.classList.toggle('dark:border-white', isActive);
        b.classList.toggle('bg-white', !isActive);
        b.classList.toggle('dark:bg-neutral-900', !isActive);
        b.classList.toggle('text-neutral-600', !isActive);
        b.classList.toggle('dark:text-neutral-400', !isActive);
        b.classList.toggle('border-neutral-200', !isActive);
        b.classList.toggle('dark:border-neutral-700', !isActive);
      });

      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    applyFilters();
  });
</script>
